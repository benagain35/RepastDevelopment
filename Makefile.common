# Shared objects rules for every Repast HPC model in this folder.
.RECIPEPREFIX = >
REPAST_HOME ?= $(HOME)/sfw/repast_hpc-2.3.1
REPAST_LIBDIR = $(REPAST_HOME)/lib
REPAST_LIBS := $(patsubst lib%.so,-l%,$(notdir $(wildcard $(REPAST_LIBDIR)/lib*.so)))

CXX = mpicxx
CXXFLAGS = -std=c++11 -O2 -MMD -MP -include boost/serialization/library_version_type.hpp -I$(REPAST_HOME)/include -Iinclude
LDFLAGS = -L$(REPAST_LIBDIR) -Wl,-rpath,$(REPAST_LIBDIR)
LDLIBS = $(REPAST_LIBS) -lboost_mpi -lboost_serialization -lboost_system -lboost_filesystem -lnetcdf_c++ -lnetcdf -lcurl

NP ?= 4
SRCS := $(wildcard src/*.cpp)
OBJS := $(patsubst src/%.cpp,objects/%.o,$(SRCS))
BIN := bin/$(MODEL)

all: $(BIN)

$(BIN): $(OBJS)
> @mkdir -p bin
> $(CXX) $(OBJS) $(LDFLAGS) $(LDLIBS) -o $@

objects/%.o: src/%.cpp
> @mkdir -p objects
> $(CXX) $(CXXFLAGS) -c $< -o $@

run: $(BIN)
> mpirun -n $(NP) ./$(BIN) props/config.props props/model.props

clean:
> rm -rf objects bin

-include $(OBJS:.o=.d)
.PHONY: all run clean
